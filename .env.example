# Copie para `.env` e preencha. NUNCA comite o `.env` real.

# Banco. SQLite no protótipo; para PostgreSQL troque o `provider` no schema.prisma
# e use: postgresql://usuario:senha@host:5432/sbp
DATABASE_URL="file:./dev.db"

# Adapter de IA: "mock" (determinístico, sem custo) ou "anthropic" (API real, gasta crédito).
# Com "anthropic", a chave é obrigatória e o sistema recusa subir sem ela — nunca
# cai no mock em silêncio. Para ver o modelo real trabalhando sem mexer no
# sistema todo: IA_ADAPTER=anthropic npm run ia:experimentar
IA_ADAPTER="mock"
ANTHROPIC_API_KEY=""
IA_MODELO="claude-sonnet-5"

# Adapter de ingestão: "mock" | "imap" | "graph" | "gmail"
INGESTAO_ADAPTER="mock"

# Onde os arquivos de anexo são guardados. FORA do repositório: são documentos
# de associado, não código. Ao migrar para nuvem, troca-se o adapter de
# armazenamento e esta variável deixa de ser usada.
ARMAZENAMENTO_DIR="./armazenamento"

# Quantos proxies confiáveis ficam na frente da aplicação.
#
# 0 = acesso direto. Nesse caso `x-forwarded-for` é escrito pelo cliente e NÃO
# identifica ninguém: o limite de taxa por origem vira limite global, mais
# frouxo, e quem contém força bruta é a trava por conta.
#
# Atrás de nginx, Cloudflare ou balanceador, ponha o número de saltos
# confiáveis (normalmente 1). Sem isso, publicar fora da rede local entrega o
# limite de taxa de graça a quem souber mandar um cabeçalho.
PROXIES_CONFIAVEIS="0"

# Segredo de sessão. Gere com: node -e "console.log(crypto.randomUUID())"
SESSAO_SECRET=""
