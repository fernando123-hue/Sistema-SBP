// Modelo de dados — Sistema de Distribuição de Demandas
//
// Provider: SQLite no protótipo, trocável para PostgreSQL alterando apenas a
// linha `provider` abaixo. Por isso NÃO usamos `enum` nem `Json` nativos:
// campos de domínio fechado são `String` validados por Zod em `src/core/esquemas.ts`,
// e payloads estruturados são `String` com JSON serializado. Zod é a fonte da
// verdade dos valores permitidos nos dois bancos — nada muda na migração.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// A URL vive em `prisma.config.ts` (exigência do Prisma 7) e o client recebe
// um driver adapter. Trocar para PostgreSQL = mudar `provider` aqui e o adapter
// em `src/servidor/prisma.ts`. Nenhum model muda.
datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// Pessoas e elegibilidade
// ─────────────────────────────────────────────────────────────

model Colaborador {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  /// operador | colaborador | gestor — validado por PapelSchema
  papel        String    @default("colaborador")
  ativo        Boolean   @default(true)
  dataEntrada  DateTime  @default(now())
  dataSaida    DateTime?

  /// Formato versionado — ver `src/servidor/credenciais.ts`. Nulo = sem acesso ainda.
  senhaHash          String?
  senhaDefinidaEm    DateTime?
  /// Senha provisória entregue pelo gestor: obriga a troca antes de usar o sistema.
  precisaTrocarSenha Boolean   @default(false)
  /// Erros consecutivos. Zera a cada entrada bem-sucedida.
  tentativasFalhas   Int       @default(0)
  bloqueadoAte       DateTime?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  habilitacoes     Habilitacao[]
  escalas          Escala[]
  atribuicoes      Atribuicao[]
  execucoes        Execucao[]
  saldosCarga      SaldoCarga[]
  saldosGlobais    SaldoCargaGlobal[]
  revisoesFeitas   Revisao[]

  @@index([ativo])
}

model Categoria {
  id     String @id @default(cuid())
  /// Estável e imutável. O rótulo muda; o código, não.
  codigo String @unique
  rotulo String
  /// CADASTRO | TITULOS
  frente String
  /// ASSOCIADO | LIGA — preserva a estrutura de E=SUM(B:D) e I=SUM(F:H)
  grupo  String
  ordem  Int    @default(0)

  divisivel         Boolean @default(true)
  peso              Float   @default(1)
  limiarIndivisivel Int     @default(3)
  limiarConfianca   Float   @default(0.85)
  entraNoRateio     Boolean @default(true)
  ativa             Boolean @default(true)

  habilitacoes  Habilitacao[]
  itens         Item[]
  rodadas       RodadaDistribuicao[]
  saldosCarga   SaldoCarga[]
  regras        RegraDistribuicao[]

  @@index([frente, grupo, ordem])
}

/// Elimina a fragilidade nº 1 da planilha: elegibilidade vira DADO, não fórmula.
model Habilitacao {
  id             String    @id @default(cuid())
  colaboradorId  String
  categoriaId    String
  podeReceber    Boolean   @default(true)
  vigenciaInicio DateTime  @default(now())
  vigenciaFim    DateTime?

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  categoria   Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, categoriaId, vigenciaInicio])
  @@index([categoriaId, podeReceber])
}

/// Substitui a coluna `J`. Diz QUEM, não só quantos.
model Escala {
  id                 String  @id @default(cuid())
  /// ISO date `YYYY-MM-DD`. Data real, não o `1..31` da planilha.
  data               String
  colaboradorId      String
  disponivel         Boolean @default(true)
  capacidadeRelativa Float   @default(1)
  observacao         String?

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([data, colaboradorId])
  @@index([data, disponivel])
}

// ─────────────────────────────────────────────────────────────
// Entrada: e-mail e item
// ─────────────────────────────────────────────────────────────

/// Metadado operacional do e-mail. Retenção LONGA.
///
/// Aqui não mora nada que identifique pessoa: só o que a operação precisa para
/// sempre — quando chegou, de onde veio, qual modelo interpretou. É esta linha
/// que sustenta métrica histórica, auditoria e conservação anos depois.
///
/// O conteúdo (remetente, assunto, corpo) vive em `EmailConteudo`, separado de
/// propósito: sem essa divisão, aplicar retenção ao dado pessoal significaria
/// apagar junto o histórico operacional, e guardar o histórico significaria
/// reter dado pessoal para sempre. As duas saídas são inaceitáveis.
model Email {
  id String @id @default(cuid())
  /// Chave de idempotência. Reprocessar o mesmo e-mail nunca duplica trabalho.
  messageId  String   @unique
  /// mock | imap | graph | gmail | manual
  origem     String   @default("mock")
  recebidoEm DateTime
  criadoEm   DateTime @default(now())

  /// Resultado bruto da IA, para auditoria da interpretação.
  modeloIa      String?
  versaoPrompt  String?
  processadoEm  DateTime?

  /// Carimbo do expurgo do conteúdo. Distingue "nunca teve" de "tinha e foi
  /// removido pela retenção" — sem ele, um e-mail sem corpo seria ambíguo, e
  /// ambiguidade silenciosa é o defeito que este sistema existe para eliminar.
  conteudoExpurgadoEm DateTime?

  conteudo EmailConteudo?
  anexos   Anexo[]
  itens    Item[]

  @@index([recebidoEm])
  @@index([origem, processadoEm])
}

/// Conteúdo do e-mail. Retenção CURTA, expurgável.
///
/// Tudo que carrega dado pessoal ou texto livre de terceiro. Apagar esta linha
/// não derruba item, atribuição, carga nem auditoria — é exatamente para isso
/// que ela é uma linha separada.
model EmailConteudo {
  emailId   String @id
  remetente String
  assunto   String
  corpo     String

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

/// Anexo do e-mail, com o arquivo guardado fora do banco.
///
/// Os METADADOS (nome, tipo, tamanho, hash, veredicto) ficam aqui e seguem a
/// retenção longa: são eles que respondem "que documento chegou nesse dia" mesmo
/// depois de o arquivo ter sido expurgado. Os BYTES ficam no armazenamento,
/// endereçados por `chaveArmazenamento`.
///
/// Antes eram um JSON dentro de `Email` — o que impedia guardar o arquivo,
/// aplicar retenção ao arquivo separada da do metadado e indexar por hash.
model Anexo {
  id            String @id @default(cuid())
  emailId       String
  /// Já normalizado: sem caminho, sem caractere de controle. Ver `validarAnexo`.
  nomeSeguro    String
  /// O que o REMETENTE alegou. Nunca é usado para decidir nada.
  tipoDeclarado String
  tamanho       Int
  /// Conteúdo do arquivo, para deduplicar e provar integridade.
  hash          String?
  aceito        Boolean @default(false)
  motivo        String?

  /// Endereço no armazenamento. Nulo = bytes nunca guardados, ou já expurgados.
  chaveArmazenamento String?
  armazenadoEm       DateTime?
  bytesExpurgadosEm  DateTime?

  criadoEm DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([hash])
}

/// A entidade que a planilha não tem. Sai a contagem anônima, entra o item.
model Item {
  id          String  @id @default(cuid())
  emailId     String?
  categoriaId String
  /// Posição dentro do desdobramento do e-mail (1 e-mail pode gerar N itens).
  sequencia   Int     @default(1)
  titulo      String
  /// JSON validado por Zod. Campos extraídos pela IA.
  payload     String  @default("{}")
  confianca   Float   @default(0)
  /// novo | aguardando_revisao | aprovado | distribuido | em_andamento | concluido | devolvido | cancelado
  status      String  @default("novo")
  ligaId      String?

  modeloIa     String?
  versaoPrompt String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Quando o item foi cancelado, se foi.
  ///
  /// `atualizadoEm` não serve: ele muda a cada escrita, então não responde
  /// "estava cancelado no dia 12?". Sem este carimbo, um cancelamento feito
  /// hoje alteraria RETROATIVAMENTE a pendência do mês passado — o painel
  /// mudaria de número sozinho entre uma consulta e outra, que é exatamente o
  /// que destrói a confiança numa comparação lado a lado com a planilha.
  ///
  /// Conclusão não precisa de coluna equivalente: ela vive em
  /// `Execucao.concluidoEm`, e item concluído nunca reabre (`devolver` recusa).
  canceladoEm  DateTime?

  /// `Restrict`, não `SetNull`: com `SetNull`, um expurgo futuro de e-mails
  /// antigos apagaria o vínculo e o item perderia remetente e assunto. Pior,
  /// `emailId = null` já significa "origem manual" no filtro de
  /// `planejarCategoria` — as duas situações ficariam indistinguíveis.
  email       Email?       @relation(fields: [emailId], references: [id], onDelete: Restrict)
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  liga        Liga?        @relation(fields: [ligaId], references: [id], onDelete: SetNull)
  atribuicoes Atribuicao[]
  execucoes   Execucao[]
  revisoes    Revisao[]

  @@unique([emailId, sequencia])
  @@index([status, categoriaId])
  @@index([categoriaId, status, criadoEm])
}

// ─────────────────────────────────────────────────────────────
// Distribuição
// ─────────────────────────────────────────────────────────────

/// Serializa as distribuições de um mesmo dia.
///
/// Sem isto, duas chamadas concorrentes de `confirmar` para categorias
/// diferentes do mesmo dia leem o crédito global uma da outra ainda não
/// gravado, e decidem o desempate com dado obsoleto. A soma persistida
/// continua correta (o crédito é somado por incremento), mas o RATEIO fica
/// injusto — a mesma pessoa pode ser favorecida duas vezes. Erro silencioso,
/// sem exceção, exatamente o tipo que este sistema existe para eliminar.
///
/// O `update` desta linha dentro da transação toma lock de linha no PostgreSQL
/// e serializa a escrita no SQLite. Portável, uma linha por dia.
model TravaDeDistribuicao {
  data         String   @id
  /// Quantas vezes o dia foi distribuído. Útil por si só na auditoria.
  execucoes    Int      @default(0)
  atualizadoEm DateTime @updatedAt
}

/// Snapshot imutável de uma decisão do motor. Auditoria completa por construção.
model RodadaDistribuicao {
  id                String @id @default(cuid())
  data              String
  categoriaId       String
  quantidadeEntrada Int
  algoritmoVersao   String
  /// sem_demanda | indivisivel | resto_maior
  criterio          String
  base              Int    @default(0)
  resto             Int    @default(0)
  cotaJusta         Float  @default(0)

  /// JSON — tudo que é preciso para reproduzir a decisão passo a passo.
  elegiveis      String
  ordemDesempate String
  alocacao       String
  creditoAntes   String
  creditoDepois  String

  executadoEm  DateTime @default(now())
  executadoPor String
  /// Correlaciona com logs e eventos de processamento.
  correlacaoId String

  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  atribuicoes Atribuicao[]

  @@index([data, categoriaId])
  @@index([correlacaoId])
}

model Atribuicao {
  id            String  @id @default(cuid())
  itemId        String
  colaboradorId String
  rodadaId      String?
  /// algoritmo | manual | transferencia | devolucao
  motivo        String
  justificativa String?
  atribuidoPor  String
  /// `true` quando vigente, `null` quando encerrada.
  /// O índice único abaixo usa a semântica de NULL distinto para garantir,
  /// NO BANCO, que cada item tem no máximo um responsável ativo (invariante 3).
  ativa         Boolean?
  atribuidoEm   DateTime @default(now())
  encerradoEm   DateTime?

  item        Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  colaborador Colaborador         @relation(fields: [colaboradorId], references: [id])
  rodada      RodadaDistribuicao? @relation(fields: [rodadaId], references: [id])

  @@unique([itemId, ativa])
  @@index([colaboradorId, ativa])
  @@index([rodadaId])
}

/// Substitui o `Realizado` digitado. Evento com carimbo, não número declarado.
model Execucao {
  id            String    @id @default(cuid())
  itemId        String
  colaboradorId String
  iniciadoEm    DateTime  @default(now())
  concluidoEm   DateTime?
  /// concluido | devolvido | cancelado
  resultado     String?
  observacao    String?

  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id])

  @@index([colaboradorId, concluidoEm])
  @@index([itemId])
}

/// O livro-razão do balanceamento. É o que a planilha não tem em lugar nenhum.
model SaldoCarga {
  id               String @id @default(cuid())
  colaboradorId    String
  categoriaId      String
  data             String
  /// CONTAGEM de itens. Continua sendo o número que a equipe reconhece.
  recebido         Int    @default(0)
  /// CARGA em unidades ponderadas. Hoje `recebido × peso da categoria`.
  ///
  /// Existe separado porque o peso vai deixar de ser por categoria e passar a
  /// ser por item (complexidade, tempo estimado). No dia em que isso acontecer,
  /// `recebido` continua respondendo "quantos itens" e este campo responde
  /// "quanta carga" — sem ele, o histórico anterior viraria incomparável com o
  /// posterior, e nenhum dos dois números significaria coisa alguma.
  recebidoPonderado Float @default(0)
  cotaJusta        Float  @default(0)
  creditoAcumulado Float  @default(0)

  /// `Restrict` nos dois lados: o livro-razão de crédito é histórico de
  /// auditoria. Apagar um colaborador não pode apagar em cascata a prova de
  /// quanto ele recebeu em rodadas passadas. O sistema desativa pessoas
  /// (`Colaborador.ativo`), nunca as remove.
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)
  categoria   Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@unique([colaboradorId, categoriaId, data])
  @@index([categoriaId, data])
}

/// Livro-razão global, POR FRENTE.
///
/// O escopo existe porque `CADASTRO` e `TITULOS` são operações distintas, com
/// equipes e pesos próprios. Um razão único somaria universos diferentes e o
/// crédito acumulado perderia significado — quem trabalhou muito numa frente
/// apareceria como credor na outra.
///
/// Acrescentar o escopo depois de `TITULOS` entrar exigiria recomputar todo o
/// histórico acumulado; agora custa uma coluna.
model SaldoCargaGlobal {
  id                 String @id @default(cuid())
  colaboradorId      String
  /// CADASTRO | TITULOS — validado por `FrenteSchema`.
  escopo             String @default("CADASTRO")
  data               String
  recebidoPonderado  Float  @default(0)
  creditoGlobal      Float  @default(0)

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)

  @@unique([colaboradorId, escopo, data])
  @@index([escopo, data])
}

// ─────────────────────────────────────────────────────────────
// Ligas
// ─────────────────────────────────────────────────────────────

model Liga {
  id          String   @id @default(cuid())
  nome        String
  instituicao String?
  uf          String?
  status      String   @default("ativa")
  criadoEm    DateTime @default(now())

  ligantes Ligante[]
  itens    Item[]

  @@unique([nome, instituicao])
}

model Ligante {
  id       String   @id @default(cuid())
  ligaId   String
  nome     String
  email    String?
  vinculo  String?
  criadoEm DateTime @default(now())

  liga Liga @relation(fields: [ligaId], references: [id], onDelete: Cascade)

  @@index([ligaId])
}

// ─────────────────────────────────────────────────────────────
// Configuração, revisão, auditoria, observabilidade
// ─────────────────────────────────────────────────────────────

/// Toda regra parametrizável vive aqui, com vigência. Nada de valor de negócio
/// hardcoded no motor.
model RegraDistribuicao {
  id             String    @id @default(cuid())
  categoriaId    String?
  /// peso | limiar_indivisivel | limiar_confianca | criterio_desempate
  tipo           String
  /// JSON
  parametros     String
  vigenciaInicio DateTime  @default(now())
  vigenciaFim    DateTime?
  ativo          Boolean   @default(true)
  criadoPor      String

  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([tipo, ativo])
}

/// Fila de exceções da IA — e dataset de melhoria contínua.
model Revisao {
  id           String    @id @default(cuid())
  itemId       String
  /// baixa_confianca | campo_ausente | duplicata_suspeita | anomalia | conteudo_suspeito
  motivo       String
  campoIncerto String?
  /// JSON
  sugestaoIa   String
  confianca    Float
  /// JSON — o que o humano decidiu de fato
  valorFinal   String?
  resolvidoPor String?
  resolvidoEm  DateTime?
  criadoEm     DateTime  @default(now())

  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  revisor   Colaborador? @relation(fields: [resolvidoPor], references: [id])

  @@index([resolvidoEm, motivo])
  @@index([itemId])
}

/// Append-only. Quem fez, quando, o quê, valor antes e depois.
model LogAuditoria {
  id           String   @id @default(cuid())
  entidade     String
  entidadeId   String
  acao         String
  /// JSON
  antes        String?
  /// JSON
  depois       String?
  usuario      String
  correlacaoId String?
  timestamp    DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([timestamp])
  @@index([correlacaoId])
}

/// Observabilidade: o que falhou, onde, quando, e se pode ser reprocessado.
model EventoProcessamento {
  id           String    @id @default(cuid())
  correlacaoId String
  etapa        String
  /// iniciado | sucesso | falha | reprocessavel
  situacao     String
  referencia   String?
  mensagem     String?
  /// JSON
  detalhe      String?
  duracaoMs    Int?
  criadoEm     DateTime  @default(now())

  @@index([correlacaoId])
  @@index([situacao, etapa])
}
