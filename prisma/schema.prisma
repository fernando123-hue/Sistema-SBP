// Modelo de dados — Sistema de Distribuição de Demandas
//
// Provider: SQLite no protótipo, trocável para PostgreSQL alterando apenas a
// linha `provider` abaixo. Por isso NÃO usamos `enum` nem `Json` nativos:
// campos de domínio fechado são `String` validados por Zod em `src/core/esquemas.ts`,
// e payloads estruturados são `String` com JSON serializado. Zod é a fonte da
// verdade dos valores permitidos nos dois bancos — nada muda na migração.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// A URL vive em `prisma.config.ts` (exigência do Prisma 7) e o client recebe
// um driver adapter. Trocar para PostgreSQL = mudar `provider` aqui e o adapter
// em `src/servidor/prisma.ts`. Nenhum model muda.
datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// Pessoas e elegibilidade
// ─────────────────────────────────────────────────────────────

model Colaborador {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  /// operador | colaborador | gestor — validado por PapelSchema
  papel        String    @default("colaborador")
  ativo        Boolean   @default(true)
  dataEntrada  DateTime  @default(now())
  dataSaida    DateTime?

  /// Formato versionado — ver `src/servidor/credenciais.ts`. Nulo = sem acesso ainda.
  senhaHash          String?
  senhaDefinidaEm    DateTime?
  /// Senha provisória entregue pelo gestor: obriga a troca antes de usar o sistema.
  precisaTrocarSenha Boolean   @default(false)
  /// Erros consecutivos. Zera a cada entrada bem-sucedida.
  tentativasFalhas   Int       @default(0)
  bloqueadoAte       DateTime?
  /// Cookie emitido ANTES deste instante não vale mais. É o que torna "sair"
  /// uma revogação de verdade, e não um gesto só do lado do navegador.
  ///
  /// Antes desta coluna, `DELETE /api/sessao` apagava o cookie do navegador e
  /// mais nada: quem tivesse copiado o valor de `sbp_sessao` continuava
  /// autenticado por até 12h, por mais vezes que o dono clicasse em "sair". O
  /// cenário não é hipotético — a equipe atende em máquina compartilhada no
  /// balcão, e `httpOnly` impede o JavaScript da página, não quem está sentado
  /// na máquina.
  ///
  /// `senhaDefinidaEm` já resolvia isso para a TROCA DE SENHA (§ A-03); o
  /// mesmo raciocínio faltava para o logout. A conferência é a mesma, na mesma
  /// consulta que `perfilAtual` já fazia — nenhuma consulta a mais.
  sessoesInvalidasAntes DateTime?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  habilitacoes     Habilitacao[]
  escalas          Escala[]
  afastamentos     Afastamento[]
  atribuicoes      Atribuicao[]
  execucoes        Execucao[]
  saldosCarga      SaldoCarga[]
  saldosGlobais    SaldoCargaGlobal[]
  revisoesFeitas   Revisao[]
  notasEscritas    Nota[]
  avisoVisto       AvisoVisto?

  @@index([ativo])
}

model Categoria {
  id     String @id @default(cuid())
  /// Estável e imutável. O rótulo muda; o código, não.
  codigo String @unique
  rotulo String
  /// CADASTRO | TITULOS
  frente String
  /// ASSOCIADO | LIGA — preserva a estrutura de E=SUM(B:D) e I=SUM(F:H)
  grupo  String
  ordem  Int    @default(0)

  divisivel         Boolean @default(true)
  peso              Float   @default(1)
  limiarIndivisivel Int     @default(3)
  limiarConfianca   Float   @default(0.85)
  entraNoRateio     Boolean @default(true)
  /// A liga e a unidade que nao se separa nesta categoria (A4). LIGANTE e EMAIL_LIGA.
  agrupaPorLiga     Boolean @default(false)
  ativa             Boolean @default(true)

  habilitacoes  Habilitacao[]
  itens         Item[]
  rodadas       RodadaDistribuicao[]
  saldosCarga   SaldoCarga[]
  regras        RegraDistribuicao[]
  notas         Nota[]

  @@index([frente, grupo, ordem])
}

/// Elimina a fragilidade nº 1 da planilha: elegibilidade vira DADO, não fórmula.
model Habilitacao {
  id             String    @id @default(cuid())
  colaboradorId  String
  categoriaId    String
  podeReceber    Boolean   @default(true)
  vigenciaInicio DateTime  @default(now())
  vigenciaFim    DateTime?

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  categoria   Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, categoriaId, vigenciaInicio])
  @@index([categoriaId, podeReceber])
}

/// Substitui a coluna `J`. Diz QUEM, não só quantos.
model Escala {
  id                 String  @id @default(cuid())
  /// ISO date `YYYY-MM-DD`. Data real, não o `1..31` da planilha.
  data               String
  colaboradorId      String
  disponivel         Boolean @default(true)
  capacidadeRelativa Float   @default(1)
  observacao         String?

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([data, colaboradorId])
  @@index([data, disponivel])
}

/// Ausência declarada de um colaborador — férias, atestado, falta (decisão A10).
///
/// Existe porque a alternativa era marcar `Escala.disponivel = false` dia a dia,
/// na mão. Duas semanas de férias eram catorze marcações que alguém precisava
/// lembrar de fazer; esquecer uma significa distribuir trabalho para quem não
/// está — e o item só aparece como parado dias depois.
///
/// NÃO substitui `Escala`: são perguntas diferentes. A escala diz quem está de
/// plantão HOJE (decisão diária, do operador); o afastamento diz quem está fora
/// NUM PERÍODO (fato, declarado uma vez). `carregarElegiveis` exige as duas
/// coisas — estar escalado e não estar afastado.
///
/// O CRÉDITO CONGELA SOZINHO, e é por isso que a entidade não tem campo para
/// isso: crédito só muda para quem entra numa rodada, e quem está afastado não
/// entra. Somado à janela deslizante de 30 dias (A9), quem volta de férias não
/// retorna como credor gigante levando tudo.
model Afastamento {
  id            String    @id @default(cuid())
  colaboradorId String
  /// ferias | falta | atestado | licenca | outro — e `ausente`, que só nasce da
  /// retenção (`A17`): passado o prazo, todo tipo que não é férias vira ele.
  tipo          String
  /// ISO date `YYYY-MM-DD`, inclusivo.
  inicio        String
  /// ISO date `YYYY-MM-DD`, inclusivo. NULO = ausência em aberto (sem data de
  /// volta definida). Falta de um dia tem `fim` igual a `inicio`.
  fim           String?
  observacao    String?

  registradoPor String
  registradoEm  DateTime  @default(now())
  /// Quando o afastamento foi cancelado. Ausência que não aconteceu é
  /// CANCELADA, nunca apagada: a trilha precisa responder por que alguém ficou
  /// fora do rateio na terça-feira passada.
  canceladoEm   DateTime?
  canceladoPor  String?
  /// Quem marcou "Voltou hoje" numa ausência sem data de volta. Junto com
  /// `registradoPor` e `canceladoPor`, diz quem mexeu por último — e o aviso do
  /// dia não acende a bolinha da gestora por uma mudança que ela mesma fez
  /// (`A39(e)`).
  encerradoPor  String?

  /// Quando o motivo saiu pelo prazo de retenção (`A17`): observação apagada e
  /// tipo reduzido. Mesmo papel de `Email.conteudoExpurgadoEm` — sem ele,
  /// `observacao` nula não diria se a ausência nunca teve observação ou se ela
  /// foi apagada, e a rotina diária voltaria a olhar a mesma linha para sempre.
  motivoExpurgadoEm DateTime?

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id])

  @@index([colaboradorId, inicio])
  @@index([inicio, fim])
  /// A rotina diária pergunta "que motivos ainda estão guardados?" — e sem este
  /// índice a pergunta varre a tabela inteira, que cresce para sempre.
  @@index([motivoExpurgadoEm])
}

// ─────────────────────────────────────────────────────────────
// Entrada: e-mail e item
// ─────────────────────────────────────────────────────────────

/// Metadado operacional do e-mail. Retenção LONGA.
///
/// Aqui não mora nada que identifique pessoa: só o que a operação precisa para
/// sempre — quando chegou, de onde veio, qual modelo interpretou. É esta linha
/// que sustenta métrica histórica, auditoria e conservação anos depois.
///
/// O conteúdo (remetente, assunto, corpo) vive em `EmailConteudo`, separado de
/// propósito: sem essa divisão, aplicar retenção ao dado pessoal significaria
/// apagar junto o histórico operacional, e guardar o histórico significaria
/// reter dado pessoal para sempre. As duas saídas são inaceitáveis.
model Email {
  id String @id @default(cuid())
  /// Chave de idempotência. Reprocessar o mesmo e-mail nunca duplica trabalho.
  messageId  String   @unique
  /// mock | imap | graph | gmail | manual
  origem     String   @default("mock")
  recebidoEm DateTime
  criadoEm   DateTime @default(now())

  /// Resultado bruto da IA, para auditoria da interpretação.
  modeloIa      String?
  versaoPrompt  String?
  processadoEm  DateTime?

  /// Carimbo do expurgo do conteúdo. Distingue "nunca teve" de "tinha e foi
  /// removido pela retenção" — sem ele, um e-mail sem corpo seria ambíguo, e
  /// ambiguidade silenciosa é o defeito que este sistema existe para eliminar.
  conteudoExpurgadoEm DateTime?

  /// As defesas contra injeção marcaram o conteúdo. Guardado porque um e-mail
  /// suspeito que não gerou item nenhum é a forma exata de uma manipulação
  /// bem-sucedida (`A34`): o conteúdo dele não sai pela retenção de `A20` antes
  /// de uma pessoa olhar. Antes ficava só no log e no evento.
  conteudoSuspeito    Boolean  @default(false)

  conteudo EmailConteudo?
  anexos   Anexo[]
  itens    Item[]

  @@index([recebidoEm])
  @@index([origem, processadoEm])
}

/// Conteúdo do e-mail. Retenção CURTA, expurgável.
///
/// Tudo que carrega dado pessoal ou texto livre de terceiro. Apagar esta linha
/// não derruba item, atribuição, carga nem auditoria — é exatamente para isso
/// que ela é uma linha separada.
model EmailConteudo {
  emailId   String @id
  remetente String
  assunto   String
  corpo     String

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

/// Anexo do e-mail, com o arquivo guardado fora do banco.
///
/// Os METADADOS (nome, tipo, tamanho, hash, veredicto) ficam aqui e seguem a
/// retenção longa: são eles que respondem "que documento chegou nesse dia" mesmo
/// depois de o arquivo ter sido expurgado. Os BYTES ficam no armazenamento,
/// endereçados por `chaveArmazenamento`.
///
/// Antes eram um JSON dentro de `Email` — o que impedia guardar o arquivo,
/// aplicar retenção ao arquivo separada da do metadado e indexar por hash.
model Anexo {
  id            String @id @default(cuid())
  emailId       String
  /// Já normalizado: sem caminho, sem caractere de controle. Ver `validarAnexo`.
  nomeSeguro    String
  /// O que o REMETENTE alegou. Nunca é usado para decidir nada.
  tipoDeclarado String
  tamanho       Int
  /// Conteúdo do arquivo, para deduplicar e provar integridade.
  hash          String?
  aceito        Boolean @default(false)
  motivo        String?

  /// Endereço no armazenamento. Nulo = bytes nunca guardados, ou já expurgados.
  chaveArmazenamento String?
  armazenadoEm       DateTime?
  bytesExpurgadosEm  DateTime?

  criadoEm DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([hash])
}

/// A entidade que a planilha não tem. Sai a contagem anônima, entra o item.
model Item {
  id          String  @id @default(cuid())
  emailId     String?
  categoriaId String
  /// Posição dentro do desdobramento do e-mail (1 e-mail pode gerar N itens).
  sequencia   Int     @default(1)
  titulo      String
  /// JSON validado por Zod. Campos extraídos pela IA.
  payload     String  @default("{}")
  confianca   Float   @default(0)
  /// novo | aguardando_revisao | aprovado | distribuido | em_andamento | concluido | devolvido | cancelado
  status      String  @default("novo")
  ligaId      String?

  modeloIa     String?
  versaoPrompt String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Quando o item foi cancelado, se foi.
  ///
  /// `atualizadoEm` não serve: ele muda a cada escrita, então não responde
  /// "estava cancelado no dia 12?". Sem este carimbo, um cancelamento feito
  /// hoje alteraria RETROATIVAMENTE a pendência do mês passado — o painel
  /// mudaria de número sozinho entre uma consulta e outra, que é exatamente o
  /// que destrói a confiança numa comparação lado a lado com a planilha.
  ///
  /// Conclusão não precisa de coluna equivalente: ela vive em
  /// `Execucao.concluidoEm`, e item concluído nunca reabre (`devolver` recusa).
  canceladoEm  DateTime?

  /// `Restrict`, não `SetNull`: com `SetNull`, um expurgo futuro de e-mails
  /// antigos apagaria o vínculo e o item perderia remetente e assunto. Pior,
  /// `emailId = null` já significa "origem manual" no filtro de
  /// `planejarCategoria` — as duas situações ficariam indistinguíveis.
  email       Email?       @relation(fields: [emailId], references: [id], onDelete: Restrict)
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  liga        Liga?        @relation(fields: [ligaId], references: [id], onDelete: SetNull)
  atribuicoes Atribuicao[]
  execucoes   Execucao[]
  revisoes    Revisao[]

  @@unique([emailId, sequencia])
  @@index([status, categoriaId])
  @@index([categoriaId, status, criadoEm])
}

// ─────────────────────────────────────────────────────────────
// Distribuição
// ─────────────────────────────────────────────────────────────

/// Serializa as distribuições de um mesmo dia.
///
/// Sem isto, duas chamadas concorrentes de `confirmar` para categorias
/// diferentes do mesmo dia leem o crédito global uma da outra ainda não
/// gravado, e decidem o desempate com dado obsoleto. A soma persistida
/// continua correta (o crédito é somado por incremento), mas o RATEIO fica
/// injusto — a mesma pessoa pode ser favorecida duas vezes. Erro silencioso,
/// sem exceção, exatamente o tipo que este sistema existe para eliminar.
///
/// O `update` desta linha dentro da transação toma lock de linha no PostgreSQL
/// e serializa a escrita no SQLite. Portável, uma linha por dia.
model TravaDeDistribuicao {
  data         String   @id
  /// Quantas vezes o dia foi distribuído. Útil por si só na auditoria.
  execucoes    Int      @default(0)
  atualizadoEm DateTime @updatedAt
}

/// Snapshot imutável de uma decisão do motor. Auditoria completa por construção.
model RodadaDistribuicao {
  id                String @id @default(cuid())
  data              String
  categoriaId       String
  quantidadeEntrada Int
  algoritmoVersao   String
  /// sem_demanda | indivisivel | resto_maior
  criterio          String
  base              Int    @default(0)
  resto             Int    @default(0)
  cotaJusta         Float  @default(0)

  /// JSON — tudo que é preciso para reproduzir a decisão passo a passo.
  elegiveis      String
  ordemDesempate String
  alocacao       String
  creditoAntes   String
  creditoDepois  String

  executadoEm  DateTime @default(now())
  executadoPor String
  /// Correlaciona com logs e eventos de processamento.
  correlacaoId String

  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  atribuicoes Atribuicao[]

  @@index([data, categoriaId])
  @@index([correlacaoId])
}

model Atribuicao {
  id            String  @id @default(cuid())
  itemId        String
  colaboradorId String
  rodadaId      String?
  /// algoritmo | manual | transferencia | devolucao
  motivo        String
  justificativa String?
  atribuidoPor  String
  /// `true` quando vigente, `null` quando encerrada.
  /// O índice único abaixo usa a semântica de NULL distinto para garantir,
  /// NO BANCO, que cada item tem no máximo um responsável ativo (invariante 3).
  ativa         Boolean?
  atribuidoEm   DateTime @default(now())
  encerradoEm   DateTime?

  item        Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  colaborador Colaborador         @relation(fields: [colaboradorId], references: [id])
  rodada      RodadaDistribuicao? @relation(fields: [rodadaId], references: [id])

  @@unique([itemId, ativa])
  @@index([colaboradorId, ativa])
  @@index([rodadaId])
}

/// Substitui o `Realizado` digitado. Evento com carimbo, não número declarado.
model Execucao {
  id            String    @id @default(cuid())
  itemId        String
  colaboradorId String
  iniciadoEm    DateTime  @default(now())
  concluidoEm   DateTime?
  /// concluido | devolvido | cancelado
  resultado     String?
  observacao    String?

  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id])

  @@index([colaboradorId, concluidoEm])
  @@index([itemId])
  /// O painel pergunta duas vezes por carregamento "o que foi concluído neste
  /// período?" — e sem este índice as duas viram varredura completa de
  /// `Execucao`, confirmado por `EXPLAIN QUERY PLAN`. `Execucao` é a única
  /// tabela do caminho do painel que cresce para sempre (uma linha por
  /// conclusão, ~16 mil por ano): as outras seis agregações usam índice de
  /// cobertura, esta não usava nenhum.
  @@index([resultado, concluidoEm])
}

/// O livro-razão do balanceamento. É o que a planilha não tem em lugar nenhum.
model SaldoCarga {
  id               String @id @default(cuid())
  colaboradorId    String
  categoriaId      String
  data             String
  /// CONTAGEM de itens. Continua sendo o número que a equipe reconhece.
  recebido         Int    @default(0)
  /// CARGA em unidades ponderadas. Hoje `recebido × peso da categoria`.
  ///
  /// Existe separado porque o peso vai deixar de ser por categoria e passar a
  /// ser por item (complexidade, tempo estimado). No dia em que isso acontecer,
  /// `recebido` continua respondendo "quantos itens" e este campo responde
  /// "quanta carga" — sem ele, o histórico anterior viraria incomparável com o
  /// posterior, e nenhum dos dois números significaria coisa alguma.
  recebidoPonderado Float @default(0)
  cotaJusta        Float  @default(0)
  creditoAcumulado Float  @default(0)

  /// `Restrict` nos dois lados: o livro-razão de crédito é histórico de
  /// auditoria. Apagar um colaborador não pode apagar em cascata a prova de
  /// quanto ele recebeu em rodadas passadas. O sistema desativa pessoas
  /// (`Colaborador.ativo`), nunca as remove.
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)
  categoria   Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@unique([colaboradorId, categoriaId, data])
  @@index([categoriaId, data])
}

/// Livro-razão global, POR FRENTE.
///
/// O escopo existe porque `CADASTRO` e `TITULOS` são operações distintas, com
/// equipes e pesos próprios. Um razão único somaria universos diferentes e o
/// crédito acumulado perderia significado — quem trabalhou muito numa frente
/// apareceria como credor na outra.
///
/// Acrescentar o escopo depois de `TITULOS` entrar exigiria recomputar todo o
/// histórico acumulado; agora custa uma coluna.
model SaldoCargaGlobal {
  id                 String @id @default(cuid())
  colaboradorId      String
  /// CADASTRO | TITULOS — validado por `FrenteSchema`.
  escopo             String @default("CADASTRO")
  data               String
  recebidoPonderado  Float  @default(0)
  creditoGlobal      Float  @default(0)

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)

  @@unique([colaboradorId, escopo, data])
  @@index([escopo, data])
}

// ─────────────────────────────────────────────────────────────
// Ligas
// ─────────────────────────────────────────────────────────────

model Liga {
  id          String   @id @default(cuid())
  nome        String
  instituicao String?
  uf          String?
  status      String   @default("ativa")
  criadoEm    DateTime @default(now())

  ligantes Ligante[]
  itens    Item[]
  notas    Nota[]

  @@unique([nome, instituicao])
}

model Ligante {
  id       String   @id @default(cuid())
  ligaId   String
  nome     String
  email    String?
  vinculo  String?
  criadoEm DateTime @default(now())

  liga Liga @relation(fields: [ligaId], references: [id], onDelete: Cascade)

  @@index([ligaId])
}

// ─────────────────────────────────────────────────────────────
// Memória do setor
// ─────────────────────────────────────────────────────────────

/// O que a equipe aprendeu operando. Retenção LONGA.
///
/// Distinta de `LogAuditoria` e `EventoProcessamento`, que também são memória:
/// aquelas registram O QUE ACONTECEU, esta registra O QUE SE APRENDEU com o
/// que aconteceu. A trilha é gerada pelo sistema e é append-only; a nota é
/// escrita por gente, e gente se corrige — por isso esta tabela tem
/// arquivamento, e a trilha não tem.
///
/// ═══ POR QUE ESTA É A MEMÓRIA MAIS LIMPA DO SISTEMA ═══
///
/// Texto de primeira pessoa, escrito por quem opera, sobre o próprio trabalho.
/// Não é dado de terceiro que um associado nunca escolheu ceder — ao contrário
/// de `Item.titulo` e `Item.payload`, que a IA extraiu do corpo do e-mail. É o
/// que a torna elegível a retenção longa por construção, e é a razão de a
/// memória do setor nascer aqui em vez de ser destilada do conteúdo recebido.
///
/// ═══ UMA PORTA SÓ ═══
///
/// `texto` é livre e os dois vínculos são opcionais. Não existe campo de tipo,
/// categoria de nota, nem formulário que obrigue a classificar antes de
/// escrever — essa exigência mata a captura, e memória em que ninguém escreve
/// não vale nada. O que a nota É se descobre depois, pelo uso: nota que se
/// repete vira candidata a regra, nota que ninguém abre morre por desuso.
///
/// ═══ NÃO HÁ VÍNCULO COM PESSOA, E ISSO É DELIBERADO ═══
///
/// Não existe `colaboradorId` de ASSUNTO aqui — só `autorId`, que é quem
/// escreveu. Anotação persistente sobre um colega, escrita por outros colegas,
/// passa por baixo do invariante 10 (métrica por pessoa é observabilidade,
/// nunca avaliação) porque texto livre não é métrica e nada no sistema o
/// intercepta. A pergunta está em `DECISOES.md § H.4`, item 13, aguardando a
/// chefia. Enquanto não houver resposta, a coluna não existe — acrescentá-la
/// depois é uma migração; retirá-la depois de povoada, não.
model Nota {
  id     String @id @default(cuid())
  /// O aprendizado, como a pessoa escreveria falando. Limite em `NotaEntradaSchema`.
  texto  String

  /// Vínculos OPCIONAIS, e é por eles que a nota encontra o trabalho em vez de
  /// esperar alguém procurá-la. Nota sem nenhum dos dois é do setor inteiro.
  categoriaId String?
  ligaId      String?

  /// Quem escreveu. `Restrict` porque a autoria é parte do valor da nota: sem
  /// ela, ninguém sabe a quem perguntar o que a linha quis dizer. O sistema
  /// desativa pessoas (`Colaborador.ativo`), nunca as remove.
  autorId  String
  criadoEm DateTime @default(now())

  /// Nota deixa de valer, nunca é apagada.
  ///
  /// Arquivar preserva a resposta a "por que a equipe conferia esse documento
  /// em março?" — que sumiria com um `DELETE`. É a mesma escolha de
  /// `Afastamento.canceladoEm`: o fato de ter valido um dia é ele próprio
  /// história operacional.
  arquivadaEm  DateTime?
  arquivadaPor String?
  motivoArquivo String?

  /// Invariante 14: toda linha de memória nasce sabendo de que domínio é.
  /// Ver `DominioSchema` e a nota em `LogAuditoria.dominio`.
  dominio String @default("distribuicao")

  /// `Restrict` NOS TRÊS, e o de `categoria`/`liga` foi corrigido antes de
  /// chegar a produção: nasceram `Cascade`.
  ///
  /// Com `Cascade`, remover uma categoria apagaria junto tudo o que o setor
  /// aprendeu sobre ela — em silêncio, sem linha na trilha, sem ninguém
  /// decidir isso. É o mesmo raciocínio que já vale para `SaldoCarga`, cujos
  /// dois lados são `Restrict` porque o livro-razão é histórico de auditoria,
  /// e é o invariante 11 no ponto exato onde ele mais custa: nunca apagar dado
  /// operacional para simplificar armazenamento.
  ///
  /// `SetNull` seria pior que `Cascade`: a nota de uma categoria removida
  /// viraria nota geral e passaria a aparecer em TODA tela do setor, com um
  /// conselho cujo contexto não existe mais.
  ///
  /// O sistema desativa categorias (`Categoria.ativa`), nunca as remove — então
  /// na prática esta trava nunca dispara. Ela existe para o dia em que alguém
  /// tentar, e para que esse alguém receba um erro em vez de um silêncio.
  autor     Colaborador @relation(fields: [autorId], references: [id], onDelete: Restrict)
  categoria Categoria?  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  liga      Liga?       @relation(fields: [ligaId], references: [id], onDelete: Restrict)

  /// A consulta quente é sempre "notas vivas deste vínculo": as telas leem por
  /// categoria e por liga, e a seleção descarta arquivada antes de ordenar.
  @@index([categoriaId, arquivadaEm])
  @@index([ligaId, arquivadaEm])
  @@index([arquivadaEm, criadoEm])
}

// ─────────────────────────────────────────────────────────────
// Configuração, revisão, auditoria, observabilidade
// ─────────────────────────────────────────────────────────────

/// Toda regra parametrizável vive aqui, com vigência. Nada de valor de negócio
/// hardcoded no motor.
model RegraDistribuicao {
  id             String    @id @default(cuid())
  categoriaId    String?
  /// peso | limiar_indivisivel | limiar_confianca | criterio_desempate
  tipo           String
  /// JSON
  parametros     String
  vigenciaInicio DateTime  @default(now())
  vigenciaFim    DateTime?
  ativo          Boolean   @default(true)
  criadoPor      String

  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([tipo, ativo])
}

/// Prazo de retenção editado pelo gestor (`A17`).
///
/// Linha só existe depois da primeira mudança: sem linha, vale o padrão
/// decidido, que mora em `core/retencao.ts`. Quem mudou, de quanto para quanto
/// e quando fica na TRILHA (`prazo_de_retencao_alterado`) — aqui é só o valor
/// em vigor, e por isso esta tabela pode ser atualizada.
model PrazoDeRetencao {
  /// `ChaveDePrazoSchema`.
  chave       String   @id
  dias        Int
  alteradoPor String
  alteradoEm  DateTime @updatedAt
}

/// Uma rotina automática, uma vez por dia (`A17`: "a limpeza roda sozinha").
///
/// `(rotina, data)` único é o que impede duas execuções no mesmo dia — o
/// servidor pode tentar de hora em hora, o `npm run` manual pode rodar junto, e
/// o modo de desenvolvimento recarrega o módulo a cada edição. Só uma ganha.
///
/// Não é trilha de auditoria: a linha muda de `em_curso` para `sucesso` ou
/// `falha`. O que cada execução apagou vai para `LogAuditoria`, linha a linha.
model ExecucaoDeRotina {
  id           String    @id @default(cuid())
  /// `RotinaSchema`.
  rotina       String
  /// Dia da operação, `YYYY-MM-DD`, no fuso de Brasília.
  data         String
  /// em_curso | sucesso | falha
  situacao     String
  tentativas   Int       @default(1)
  iniciadaEm   DateTime  @default(now())
  concluidaEm  DateTime?
  /// JSON com contagens. Nunca nome, tipo de afastamento nem conteúdo.
  resumo       String?
  /// Já passada por `mensagemPersistivel`.
  mensagem     String?
  correlacaoId String

  @@unique([rotina, data])
}

/// O que cada gestora já viu do aviso do dia (`A17`, `A39(e)`).
///
/// Existe para o aviso dizer o que MUDOU desde a última olhada — inclusive a
/// troca de uma pessoa por outra no mesmo dia, que uma contagem não enxerga.
///
/// Guarda só chaves internas (`fora:<id do afastamento>`), nunca nome nem
/// motivo: o motivo tem prazo (`A17`), e uma cópia dele aqui escaparia da
/// limpeza. Uma linha por gestora, reescrita a cada olhada — é estado de tela,
/// não histórico operacional, e por isso não vai para a trilha.
model AvisoVisto {
  colaboradorId String   @id
  /// Dia da operação, `YYYY-MM-DD`.
  data          String
  /// JSON — `ChavesDoAvisoSchema`.
  chaves        String
  vistoEm       DateTime @updatedAt

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
}

/// Fila de exceções da IA — e dataset de melhoria contínua.
model Revisao {
  id           String    @id @default(cuid())
  itemId       String
  /// baixa_confianca | campo_ausente | duplicata_suspeita | anomalia | conteudo_suspeito
  motivo       String
  campoIncerto String?
  /// JSON
  sugestaoIa   String
  confianca    Float
  /// JSON — o que o humano decidiu de fato
  valorFinal   String?
  resolvidoPor String?
  resolvidoEm  DateTime?
  criadoEm     DateTime  @default(now())

  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  revisor   Colaborador? @relation(fields: [resolvidoPor], references: [id])

  @@index([resolvidoEm, motivo])
  @@index([itemId])
}

/// Append-only. Quem fez, quando, o quê, valor antes e depois.
model LogAuditoria {
  id           String   @id @default(cuid())
  /// Qual sistema do ecossistema escreveu esta linha. Ver `DominioSchema`.
  ///
  /// ESTA COLUNA NÃO TEM BACKFILL POSSÍVEL. A trilha é append-only por
  /// invariante — corrigir um dado gera linha nova, nunca reescreve a
  /// anterior. Então uma linha gravada hoje sem domínio fica sem domínio
  /// para sempre, e no dia em que um segundo sistema escrever aqui não
  /// haverá como separar a história de um da história do outro.
  ///
  /// É o mesmo raciocínio que já valeu para `SaldoCargaGlobal.escopo`
  /// (`H-D6`): acrescentar escopo a um razão já acumulado exige recomputar
  /// histórico. Aqui é pior — não dá nem para recomputar.
  ///
  /// SEM ÍNDICE PRÓPRIO, de propósito. Com um domínio só, a cardinalidade é 1:
  /// `[dominio, timestamp]` seria um duplicado de `[timestamp]` e só encareceria
  /// a escrita na tabela mais escrita do sistema. O índice entra no dia em que
  /// existir um segundo domínio — e aí custa o mesmo que hoje, ao contrário da
  /// coluna.
  dominio      String   @default("distribuicao")
  entidade     String
  entidadeId   String
  acao         String
  /// JSON
  antes        String?
  /// JSON
  depois       String?
  usuario      String
  correlacaoId String?
  timestamp    DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([timestamp])
  @@index([correlacaoId])
}

/// Observabilidade: o que falhou, onde, quando, e se pode ser reprocessado.
model EventoProcessamento {
  id           String    @id @default(cuid())
  /// Qual sistema do ecossistema gerou este evento. Ver `DominioSchema`.
  ///
  /// `etapa` é string livre e não serve de substituto: "ingestao" pode
  /// existir em qualquer sistema futuro, e as duas séries se somariam numa
  /// consulta sem que nada acusasse.
  dominio      String    @default("distribuicao")
  correlacaoId String
  etapa        String
  /// iniciado | sucesso | falha | reprocessavel
  situacao     String
  referencia   String?
  mensagem     String?
  /// JSON
  detalhe      String?
  duracaoMs    Int?
  criadoEm     DateTime  @default(now())

  @@index([correlacaoId])
  @@index([situacao, etapa])
}
