node_modules/
.worktrees/
# Gerado por `next dev`, `next build` e `next typegen`, em variantes diferentes
# para cada um. Commitado, sujava a árvore a cada execução. A documentação do
# Next manda ignorar; o CI e o `typecheck` o geram com `next typegen`.
next-env.d.ts
.next/
out/
dist/
coverage/
*.log

# Segredos — nunca comitar o .env real
.env
.env.*
!.env.example

# Banco local (SQLite). Dados sintéticos, mas fora do repositório.
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/*.db

# Cliente Prisma gerado — reconstruído por `prisma generate`
src/generated/

# Arquivos de anexo. São DOCUMENTOS DE ASSOCIADO, não código: nunca entram no
# repositório, nem os sintéticos — para que ninguém aprenda que esse diretório
# pode ser comitado. Configurável por ARMAZENAMENTO_DIR.
armazenamento/

# Cache incremental do TypeScript. Artefato de build: muda a cada typecheck e
# sujava o diff de todo commit.
*.tsbuildinfo

.DS_Store
Thumbs.db
